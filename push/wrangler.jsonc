{
  "name": "matura-push",
  "main": "worker.js",
  "compatibility_date": "2026-11-15",
  "triggers": {
    "crons": ["1 22 * * *", "1 23 * * *"]
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://scheurermarc77-spec.github.io",
    "VAPID_SUBJECT": "mailto:CHANGE-TO-YOUR-EMAIL@example.com",
    "VAPID_PUBLIC_KEY": "CHANGE_AFTER_GENERATING_KEYS"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "matura-push",
    "database_id": "REPLACE_WITH_D1_DATABASE_ID"
  }]
}
